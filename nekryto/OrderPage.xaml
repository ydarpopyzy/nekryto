<Page x:Class="nekryto.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:nekryto"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина" Background="#FFF8E1" Height="521" Width="825" Foreground="#FFB300">

    <Grid Background="#FFF8E1" Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="✕" Width="30" Height="30" Background="Transparent" 
                Foreground="#FFB300" BorderThickness="0" FontSize="16"
                HorizontalAlignment="Right" Click="CloseButton_Click" Grid.Row="0"/>

        <TextBlock Text="Состав заказа" FontSize="20" FontWeight="Bold" Margin="10" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" Margin="10,0,10,0" VerticalScrollBarVisibility="Auto">
            <ListView Name="OrderListView" Background="#FFF8E1" Foreground="#FFB300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ProductName}" Grid.Column="0"/>
                            <TextBlock Text="{Binding Price}" TextDecorations="Strikethrough" Grid.Column="1"/>
                            <TextBlock Text="{Binding DiscountedPrice}" Grid.Column="2"/>
                            <Button Content="Удалить" Width="75" Background="#FFF8E1" Foreground="#FFB300" 
                                    Click="RemoveButton_Click" Grid.Column="3" Margin="5,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <TextBlock x:Name="TotalCost" FontSize="16" Margin="10" Grid.Row="2"/>

        <Button Content="Закрыть" Width="100" Height="30" Background="#FFF8E1" Foreground="#FFB300" 
                Margin="10" Click="CloseButton_Click" Grid.Row="3" HorizontalAlignment="Left"/>
    </Grid>
</Page>